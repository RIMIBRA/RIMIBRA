API_FOOTBALL_KEY=your_api_key_here
THE_ODDS_API_KEY=optional_free_key_from_the-odds-api.com
PORT=3000

# Une seule clé api-sports.io couvre tous les sports (Football, NFL, Basketball,
# Hockey, Baseball, Handball) — pas de clé séparée par sport.

DATABASE_URL=postgresql://user:password@localhost:5432/rimibra
JWT_SECRET=generate_a_long_random_string_here

# Tennis — fournisseur différent (api-tennis.com), clé séparée
API_TENNIS_KEY=your_api_tennis_key_here
