API_FOOTBALL_KEY=your_api_key_here
THE_ODDS_API_KEY=optional_free_key_from_the-odds-api.com
PORT=3000

# Une seule clé api-sports.io couvre tous les sports (Football, NFL, Basketball,
# Hockey, Baseball, Handball) — pas de clé séparée par sport.

DATABASE_URL=postgresql://user:password@localhost:5432/rimibra
JWT_SECRET=generate_a_long_random_string_here

# Tennis — fournisseur différent (api-tennis.com), clé séparée
API_TENNIS_KEY=your_api_tennis_key_here
# Optionnel : force le quota journalier tennis (sinon auto-géré par date d'essai, voir tennisClient.js)
API_TENNIS_DAILY_LIMIT=

# Paiement des abonnements Premium/VIP (voir payments/geniuspay.js). Clés dans le dashboard
# GeniusPay -> Paramètres -> API. whsec_... obtenu en créant un webhook pointant vers
# https://tondomaine.com/api/payments/geniuspay/webhook (voir docs GeniusPay).
GENIUSPAY_API_KEY=pk_live_or_sandbox_xxx
GENIUSPAY_API_SECRET=sk_live_or_sandbox_xxx
GENIUSPAY_WEBHOOK_SECRET=whsec_xxx
# URL publique du site, utilisée pour construire les liens de redirection après paiement
SITE_URL=https://footpredictongoal.com

# Notifications push navigateur (Web Push) — combinés spéciaux créés/résolus, Premium/VIP
# uniquement (voir push/webPush.js). Génère une paire de clés avec :
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Absentes -> les notifications sont silencieusement désactivées (pas de crash).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:rimtechdigital@gmail.com

# Email "mot de passe oublié" (voir email/mailer.js) — SMTP générique, marche avec n'importe
# quel fournisseur. Option la plus simple sans nouveau compte à créer : Gmail avec un mot de
# passe d'application (myaccount.google.com/apppasswords, nécessite la validation en 2 étapes) :
#   SMTP_HOST=smtp.gmail.com / SMTP_PORT=587 / SMTP_USER=tonadresse@gmail.com / SMTP_PASS=<mot de passe d'application, pas le mot de passe du compte>
# Absentes -> en dev le lien de réinitialisation est juste loggué dans la console (pas de crash) ;
# en prod, aucun email n'est envoyé et une erreur est logguée côté serveur.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=footpredictongoal <rimtechdigital@gmail.com>
